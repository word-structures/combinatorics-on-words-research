{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reliability Engine Failure Ledger",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "failure_id": {
            "type": "string",
            "pattern": "^FL-\\\\d{3}$"
          },
          "episode": { "type": "string", "minLength": 1 },
          "date": {
            "type": "string",
            "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
          },
          "observed_symptom": { "type": "string", "minLength": 1 },
          "failure_mode": { "type": "string", "minLength": 1 },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["human", "AI", "tool", "system"]
            },
            "minItems": 1
          },
          "triggering_conditions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "why_plausible": { "type": "string", "minLength": 1 },
          "scientific_impact": { "type": "string", "minLength": 1 },
          "epistemic_impact": { "type": "string", "minLength": 1 },
          "detection_layer": { "type": "string", "minLength": 1 },
          "preserved_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": {
                  "anyOf": [
                    { "type": "null" },
                    { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
                  ]
                }
              },
              "required": ["path", "sha256"],
              "additionalProperties": false
            }
          },
          "corrective_action": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "defense_introduced": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "recurrence_test": {
            "type": "object",
            "properties": {
              "path": {
                "anyOf": [
                  { "type": "null" },
                  { "type": "string", "minLength": 1 }
                ]
              }
            },
            "required": ["path"],
            "additionalProperties": false
          },
          "dataset_role": {
            "type": "string",
            "enum": ["ENGINE_DESIGN_SET", "ENGINE_EVAL_SET"]
          },
          "residual_risk": { "type": "string", "minLength": 1 }
        },
        "required": [
          "failure_id", "episode", "date", "observed_symptom", "failure_mode",
          "actors", "triggering_conditions", "why_plausible", "scientific_impact",
          "epistemic_impact", "detection_layer", "preserved_artifacts",
          "corrective_action", "defense_introduced", "recurrence_test",
          "dataset_role", "residual_risk"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "failures"],
  "additionalProperties": false
}
